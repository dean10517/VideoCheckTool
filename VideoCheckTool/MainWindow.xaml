<Window x:Class="VideoCheckTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media Sorter" Width="1440" Height="860" MinWidth="1100" MinHeight="680"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#11141A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Content="選擇來源資料夾" Click="ChooseSource_Click"/>
                <TextBlock x:Name="sourcePathText" Grid.Column="1" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}"/>
                <CheckBox x:Name="includeSubfoldersCheck" Grid.Column="2" Content="包含子資料夾" VerticalAlignment="Center" Checked="IncludeSubfolders_Changed" Unchecked="IncludeSubfolders_Changed"/>
                <Button Grid.Column="3" Content="↻ 重新掃描" Click="Refresh_Click"/>
                <Button Grid.Column="4" Content="⚙ 設定" Click="Settings_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{StaticResource PanelBrush}">
                <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="14,0">
                    <TextBlock Text="SOURCE" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#303645" CornerRadius="10" Padding="8,2"><TextBlock x:Name="sourceCountText" Text="0"/></Border>
                </Grid>
                <ListBox x:Name="sourceList" Grid.Row="1" SelectionChanged="SourceList_SelectionChanged" MouseDoubleClick="SourceList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding KindGlyph}" Foreground="{StaticResource AccentBrush}"/>
                                <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DirectoryName}" FontSize="10" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#0E1015"/>

            <Grid Grid.Column="2" Margin="16,12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="96"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="currentFileText" Text="尚未選擇檔案" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
                <Border Grid.Row="1" Background="#08090C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                    <Grid ClipToBounds="True">
                        <Image x:Name="imagePreview" Stretch="Uniform" Visibility="Collapsed"/>
                        <MediaElement x:Name="videoPreview" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" Visibility="Collapsed" MediaOpened="VideoPreview_MediaOpened" MediaEnded="VideoPreview_MediaEnded" MediaFailed="VideoPreview_MediaFailed"/>
                        <StackPanel x:Name="emptyPreview" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="▻" FontSize="72" Foreground="#4B5563" HorizontalAlignment="Center"/>
                            <TextBlock Text="從左側選擇影片或照片" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="currentTimeText" Text="00:00" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                        <Slider x:Name="seekSlider" Grid.Column="1" Margin="10,0" Minimum="0" Maximum="1" IsEnabled="False"/>
                        <TextBlock x:Name="durationText" Grid.Column="2" Text="00:00" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Content="← 上一個" Click="Previous_Click"/>
                        <Button x:Name="playPauseButton" Content="▶ 播放" Width="94" Click="PlayPause_Click" IsEnabled="False"/>
                        <Button Content="下一個 →" Click="Next_Click"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="3" Margin="0,8,0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Height="46" Background="#1D4ED8" FontWeight="SemiBold" Content="A   分類到 A" Click="MoveToA_Click"/>
                    <Button Grid.Column="1" Height="46" Background="#B45309" FontWeight="SemiBold" Content="D   分類到 D" Click="MoveToD_Click"/>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="#0E1015"/>

            <Grid Grid.Column="4" Background="{StaticResource PanelBrush}">
                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="1"/><RowDefinition/></Grid.RowDefinitions>
                <Grid Grid.Row="0"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition/></Grid.RowDefinitions>
                    <StackPanel Margin="14,8"><TextBlock Text="A  分類結果" FontWeight="SemiBold" Foreground="#93C5FD"/><TextBlock x:Name="aPathText" FontSize="10" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
                    <ListBox x:Name="aList" Grid.Row="1" PreviewMouseRightButtonDown="TargetList_PreviewMouseRightButtonDown" MouseDoubleClick="TargetList_MouseDoubleClick">
                        <ListBox.ContextMenu><ContextMenu><MenuItem Header="分類到 D 資料夾" Click="MoveAItemToD_Click"/><Separator/><MenuItem Header="還原到原本路徑" Click="RestoreAItem_Click"/></ContextMenu></ListBox.ContextMenu>
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
                <Border Grid.Row="1" Background="{StaticResource BorderBrush}"/>
                <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition/></Grid.RowDefinitions>
                    <StackPanel Margin="14,8"><TextBlock Text="D  分類結果" FontWeight="SemiBold" Foreground="#FCD34D"/><TextBlock x:Name="dPathText" FontSize="10" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
                    <ListBox x:Name="dList" Grid.Row="1" PreviewMouseRightButtonDown="TargetList_PreviewMouseRightButtonDown" MouseDoubleClick="TargetList_MouseDoubleClick">
                        <ListBox.ContextMenu><ContextMenu><MenuItem Header="分類到 A 資料夾" Click="MoveDItemToA_Click"/><Separator/><MenuItem Header="還原到原本路徑" Click="RestoreDItem_Click"/></ContextMenu></ListBox.ContextMenu>
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#11141A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="10,0"><TextBlock x:Name="statusText" Text="就緒" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/><TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="A / D 分類　　← / → 切換"/></Grid>
        </Border>
    </Grid>
</Window>
